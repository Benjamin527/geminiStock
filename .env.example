# SYMBOLS=["SPY","QQQ"]
SYMBOLS=["CONL","TSLL"]
BENCHMARK_SYMBOLS=["CONL"]
DATA_PROVIDER=yfinance
# 可选：DATA_PROVIDER=polygon 或 auto；auto 在配置 POLYGON_API_KEY 时优先使用 Polygon。
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io
MARKET_DATA_TIMEOUT_SECONDS=20
NEWS_PROVIDER=none

LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_FALLBACK_ON_ERROR=true

DATABASE_PATH=data/gemini_stock.sqlite
CHART_DIR=charts
DASHBOARD_DATA_SOURCE=sqlite
# 调度已按美股盘前/盘中/盘后自动切换，保留此项仅兼容旧配置。
POLL_INTERVAL_MINUTES=15
ALERT_COOLDOWN_MINUTES=60
DELAYED_DATA_TOLERANCE_MINUTES=30
WORKER_STALE_AFTER_INTERVALS=2.5
MAX_SCHEDULER_SLEEP_SECONDS=300

SYNC_REMOTE_MYSQL=false
REMOTE_MYSQL_HOST=
REMOTE_MYSQL_PORT=3306
REMOTE_MYSQL_USER=
REMOTE_MYSQL_PASSWORD=
REMOTE_MYSQL_DATABASE=gemini_stock

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=

RUN_ONCE=false
